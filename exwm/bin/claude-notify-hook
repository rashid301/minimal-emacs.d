#!/usr/bin/env python3
"""Claude Code hook (Notification / Stop): mark the Claude in Emacs' agents sidebar
and show a Windows toast that jumps back to it.  Reads the hook JSON on stdin."""
import json, os, subprocess, sys, urllib.parse

HERE = os.path.dirname(os.path.realpath(__file__))
try:
    data = json.load(sys.stdin)
except Exception:
    data = {}
event = data.get("hook_event_name", "Notification")
message = data.get("message") or ("Claude finished" if event == "Stop" else "Claude needs you")

pids, p = [], os.getpid()
while p > 1:
    pids.append(p)
    try:
        p = int(open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()[1])
    except Exception:
        break

def lisp_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'

short, buf, toast = os.path.basename(data.get("cwd", "") or "claude"), "", "1"
try:
    expr = "(ghostel-claude-workspace-event '(%s) %s %s)" % (
        " ".join(map(str, pids)), lisp_str(event), lisp_str(message))
    out = subprocess.run(["emacsclient", "-e", expr], capture_output=True, text=True, timeout=5).stdout.strip()
    if out.startswith('"'):
        out = json.loads(out, strict=False)
        if out:
            short, buf, toast = (out.split("\n") + ["", "", "1"])[:3]
except Exception:
    pass

if toast == "1":
    title = ("Claude needs you" if event == "Notification" else "Claude is done") + f" — {short}"
    url = "claude-focus://" + urllib.parse.quote(buf, safe="") if buf else ""
    subprocess.Popen([os.path.join(HERE, "winnotify"), title, message, url],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
